#!/bin/sh
# Kut pre-menu telemetry screen.
#
# This is installed as /etc/grub.d/05_kut_telemetry and runs while
# grub-mkconfig builds grub.cfg.  It emits GRUB script commands, so the real
# SMBIOS identity and current date are shown once before the boot menu.
set -e

. "$pkgdatadir/grub-mkconfig_lib"

# grub-mkconfig does not export arbitrary /etc/default/grub variables to the
# hooks, so read the two Kut switches directly instead of relying on the
# environment.
read_setting() {
    key=$1
    [ -r /etc/default/grub ] || return 0
    sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*//p" /etc/default/grub |
        tail -n 1 |
        sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//"
}

telemetry=$(read_setting KUT_TELEMETRY)
[ -n "$telemetry" ] || telemetry=1
case "$telemetry" in
    0 | no | false | off | disabled) exit 0 ;;
esac

delay=$(read_setting KUT_TELEMETRY_DELAY)
case "$delay" in
    '' | *[!0-9]*) delay=3 ;;
esac
[ "$delay" -gt 10 ] && delay=10
[ "$delay" -lt 1 ] && exit 0

theme=${GRUB_THEME:-/boot/grub/themes/kut/theme.txt}
themedir=$(dirname "$theme")
background=

if [ -r "$themedir/background.png" ]; then
    theme_rel=$(make_system_path_relative_to_its_root "$themedir")
    [ -n "$theme_rel" ] || theme_rel=/boot/grub/themes/kut
    # Refuse a single quote rather than emitting broken GRUB quoting.
    case "$theme_rel" in
        *"'"*) theme_rel=/boot/grub/themes/kut ;;
    esac
    background="(\$root)$theme_rel/background.png"
fi

cat << EOF
# --- Kut pre-menu telemetry -----------------------------------------------
insmod smbios
insmod date
insmod sleep
insmod png
insmod gfxterm_background

set kut_bios_vendor=UNKNOWN
set kut_bios_version=UNKNOWN
set kut_bios_date=UNKNOWN
set kut_sys_vendor=UNKNOWN
set kut_sys_product=UNKNOWN
set kut_board_vendor=UNKNOWN
set kut_board_product=UNKNOWN
set kut_cpu_vendor=UNKNOWN
set kut_cpu_version=UNKNOWN

smbios -t 0 -s 4 --set kut_bios_vendor
smbios -t 0 -s 5 --set kut_bios_version
smbios -t 0 -s 8 --set kut_bios_date
smbios -t 1 -s 4 --set kut_sys_vendor
smbios -t 1 -s 5 --set kut_sys_product
smbios -t 2 -s 4 --set kut_board_vendor
smbios -t 2 -s 5 --set kut_board_product
smbios -t 4 -s 7 --set kut_cpu_vendor
smbios -t 4 -s 16 --set kut_cpu_version

if [ "\$grub_platform" = "efi" ]; then
  set kut_boot_mode=UEFI
else
  set kut_boot_mode=BIOS
fi
set kut_arch=\$grub_cpu

set gfxterm_font="Share Tech Mono Regular 16"
terminal_output gfxterm
set color_normal=light-cyan/black
set color_highlight=black/light-cyan
EOF

if [ -n "$background" ]; then
    cat << EOF
background_image -m normal "$background"
EOF
fi

cat << EOF
clear
echo "  +------------------------------------------------------------+"
echo "  |  KUT  //  PRE-BOOT TELEMETRY                                |"
echo "  +------------------------------------------------------------+"
echo "  FIRMWARE   : \$kut_bios_vendor \$kut_bios_version"
echo "  BIOS DATE  : \$kut_bios_date"
echo "  SYSTEM     : \$kut_sys_vendor \$kut_sys_product"
echo "  BOARD      : \$kut_board_vendor \$kut_board_product"
echo "  PROCESSOR  : \$kut_cpu_vendor \$kut_cpu_version"
echo "  PLATFORM   : \$kut_boot_mode / \$kut_arch"
echo "  LOCAL TIME :"
date
echo ""
echo "  Booting menu in $delay seconds   [ESC] skip"
sleep --interruptible $delay
set color_normal=white/black
set color_highlight=black/light-gray
clear
# --- end Kut pre-menu telemetry -------------------------------------------
EOF
