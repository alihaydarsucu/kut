#!/bin/sh
# Refresh kut/theme.txt with current machine information.
#
# Installed as /etc/grub.d/06_kut_info.  update-grub runs this hook
# before the menu entries are generated, so kernel/distro/RAM/CPU labels stay
# accurate after upgrades without touching the artwork.
set -e

theme=${GRUB_THEME:-/boot/grub/themes/kut/theme.txt}
themedir=$(dirname "$theme")
template="$themedir/theme.txt.in"

if [ ! -r "$template" ]; then
    exit 0
fi

renderer=
for candidate in \
    /usr/local/sbin/kut-render-theme \
    "$themedir/render_theme.sh"; do
    if [ -x "$candidate" ]; then
        renderer=$candidate
        break
    fi
done

if [ -z "$renderer" ]; then
    printf 'Kut: theme renderer not found; keeping %s\n' "$theme" >&2
    exit 0
fi

if ! "$renderer" "$template" "$theme" >&2; then
    printf 'Kut: could not refresh %s; keeping the previous file\n' "$theme" >&2
fi

exit 0
